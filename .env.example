# Neon Voice Journal — env template
# Copy to .env and fill in.

# --- Database (Neon Postgres) ---
# e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Single-user mode (no auth yet). Used as default userId for all queries.
DEFAULT_USER_ID="demo-user"
DEFAULT_USER_EMAIL="you@example.com"

# --- Object storage (S3-compatible: AWS S3 or Cloudflare R2) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="journal-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for rendering attachments (R2 public domain or CloudFront/CDN).
# If empty, app falls back to private presigned URLs where possible.
S3_PUBLIC_BASE_URL=""

# --- AI (optional, BYOK — Gemini) ---
# Free key: https://aistudio.google.com/apikey
# Used for voice transcription, summaries, tags, Ask-my-journal.
GEMINI_API_KEY=""
# e.g. gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL="gemini-2.0-flash"

# --- Auth (optional, Clerk — per-user private journals) ---
# Free: https://dashboard.clerk.com → Create app → API keys.
# Leave empty for single-user demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

NEXT_PUBLIC_APP_NAME="Your Voice Journal"
